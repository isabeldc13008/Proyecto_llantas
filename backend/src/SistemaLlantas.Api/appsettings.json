{
  "Jwt": {
    "Issuer": "SistemaLlantas",
    "Audience": "SistemaLlantas.Web"
  },
  "FrontendUrl": "http://localhost:4200",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Mode": "Entra"
  },
  "Entra": {
    "Scope": "access_as_user",
    "ClientId": "<API_CLIENT_ID>",
    "TenantId": "<TENANT_ID>"
  }
}
