@startuml
title Arquitectura de alto nivel - Sistema de Gestion de Llantas GLLD
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle

actor "Usuarios operativos\nTecnicos, supervisores, administradores" as Users
component "Aplicacion web\nAngular 20\nHTTPS" as Angular
component "API REST\nASP.NET Core .NET 10" as Api
component "Logica de negocio\nApplication + Domain\ncasos de uso y reglas" as Business
component "Persistencia\nEF Core y migraciones" as Persistence
component "Controladores\nDashboard, inventario, inspecciones,\noperaciones, servicios y reportes" as Controllers
component "Autenticacion y autorizacion\nJWT, permisos y alcance por centro" as Auth
component "Almacenamiento de evidencias\nfilesystem o servicio del ambiente" as Evidence
database "SQL Server / Azure SQL\nTBL_* del sistema, seguridad y auditoria" as Sql
cloud "Microsoft Entra ID\nsegun configuracion del ambiente" as Entra
component "Modulos funcionales\nllantas, inspecciones, alertas,\nprogramacion y operaciones" as Modules
component "GitHub Actions\nbuild, pruebas y migraciones" as Ci

Users --> Angular : HTTPS
Angular --> Api : REST / JSON
Api --> Business : DTO y reglas
Business --> Persistence : consultas y comandos
Persistence --> Sql : SQL
Api --> Auth : identidad y permisos
Auth --> Entra : OpenID Connect / JWT
Api --> Controllers : endpoints
Controllers --> Modules : casos funcionales
Business --> Evidence : archivos de inspeccion
Ci ..> Angular : build y pruebas
Ci ..> Api : build y pruebas
Ci ..> Sql : migraciones

note right of Sql
  Inventario, llantas, vehiculos,
  inspecciones, alertas, movimientos,
  programacion, servicios, seguridad
  y auditoria.
end note
@enduml
