@startuml
title Arquitectura de alto nivel - Sistema de Gestion de Llantas GLLD
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle

actor "Usuarios operativos\nTecnicos, supervisores, administradores" as Users
package "Capa de presentacion" as Presentation {
  component "Aplicacion web\nAngular 20" as Angular
  component "Guards e interceptores\npermisos y token" as Guards
}
package "Servicios web" as Web {
  component "API REST\nASP.NET Core .NET 10" as Api
  component "Autenticacion y autorizacion\nJWT / Entra ID segun ambiente" as Auth
  component "Controladores\nDashboard, inventario, inspecciones,\noperaciones, servicios y reportes" as Controllers
  component "Application\ncasos de uso, DTO y validaciones" as Application
  component "Domain\nreglas y estados de negocio" as Domain
  component "Infrastructure\nEF Core, migraciones y servicios" as Infrastructure
}
database "SQL Server / Azure SQL\nTBL_* del sistema" as Sql
component "Almacenamiento de evidencias\nfilesystem o almacenamiento del ambiente" as Evidence
cloud "Microsoft Entra ID\ncuando el ambiente lo requiere" as Entra
component "GitHub Actions\nconstruccion y pruebas" as Ci

Users --> Angular : HTTPS
Angular --> Guards : navega y valida modulo
Angular --> Api : HTTPS / JSON
Api --> Auth : valida identidad y permisos
Auth --> Entra : OpenID Connect / JWT
Api --> Controllers
Controllers --> Application
Application --> Domain
Application --> Infrastructure
Infrastructure --> Sql : EF Core / SQL
Controllers --> Evidence : carga y consulta de archivos
Ci ..> Angular : build y pruebas
Ci ..> Api : build, pruebas y migraciones

note right of Sql
  Inventario, llantas, vehiculos,
  inspecciones, alertas, movimientos,
  programacion, servicios, seguridad
  y auditoria.
end note
@enduml
